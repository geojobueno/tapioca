    "tempbuild = TemperatureFieldBuilder(scen,lithosphere_interface=0,c_cap=1250,g=-10,alpha = 0.0000328)\n",
    "tempbuild.apply_linear_temperature(t_pot=1350)\n",
    "for j in range(tempbuild.Nx):\n",
    "    print(j)\n",
    "    tempbuild.temperature.values[:,j] = tempbuild.solve_heat_column(x_inx=j,mode='nothing')"
   ]
